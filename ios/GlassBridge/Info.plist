<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>CŞ AI Systems</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GlassBridge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glassbridge</string>
			</array>
		</dict>
	</array>
	<!-- Meta Wearables Device Access Toolkit -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>glassbridge://</string>
		<!-- Developer Mode: 0 = App ID yok, attestation atlanir -->
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Meta gözlüğe bağlanmak için gerekli.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Meta gözlüğe bağlanmak için gerekli.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Kayıtlardaki fotoğraf ve videoları Fotoğraflar'a kaydetmek için.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kişi sayım oturumuna, sayımın yapıldığı yerin adını eklemek için.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sesli komutlar (örn. "yapay zekâ katmanını çalıştır", "Claude, …") için gözlük mikrofonu dinlenir.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sesli komutları anlamak için konuşma cihaz üzerinde yazıya çevrilir.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Gözlüğe Wi-Fi ile bağlanmak ve görüntüyü bilgisayarına göndermek için gerekli.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<!-- Kullanicinin kendi PC'sine (LAN veya Tailscale 100.x / makine adi) http/ws baglantisi:
	     video oynatma ve yuz resimleri icin. Tailscale trafigi zaten WireGuard ile sifreli.
	     Not: NSAllowsLocalNetworking ile birlikte yazilirsa iOS bu anahtari yok sayar; tek basina. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
